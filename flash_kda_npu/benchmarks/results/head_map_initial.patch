+@lru_cache(maxsize=128)
+def _persistent_head_map(counts, heads, blocks, cap, mode):
+    order = sorted(range(len(counts) * heads),
+                   key=lambda h: (-counts[h // heads], h))
+    groups = [[] for _ in range(blocks)]
+    if mode == "balanced":
+        slots = [(0, b) for b in range(blocks)]
+        for head in order:
+            load, b = heapq.heappop(slots)
+            groups[b].append(head)
+            if len(groups[b]) < cap:
+                heapq.heappush(slots, (load + counts[head // heads], b))
+    else:
+        if mode == "contiguous":
+            order = list(range(len(counts) * heads))
+        width, extra = divmod(len(order), blocks)
+        start = 0
+        for b in range(blocks):
+            size = width + (b < extra)
+            groups[b] = order[start:start + size]
+            start += size
+    return tuple(head for group in groups
+                 for head in group + [-1] * (cap - len(group)))
 
 
